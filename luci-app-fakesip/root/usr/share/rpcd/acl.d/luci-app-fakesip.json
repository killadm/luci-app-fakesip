{
	"luci-app-fakesip": {
		"description": "Grant access to LuCI app FakeSIP",
		"read": {
			"uci": [ "fakesip" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/etc/crontabs/root": [ "read" ],
				"/usr/libexec/fakesip-logread": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "fakesip" ],
			"file": {
				"/etc/init.d/fakesip": [ "exec" ],
				"/usr/libexec/fakesip-update": [ "exec" ]
			}
		}
	}
}
